[Unit]
Description=Private LENS connection to RunPod Ollama
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/lens/runpod-tunnel.env
ExecStart=/usr/bin/ssh -N -T -p ${RUNPOD_SSH_PORT} -i /etc/lens/tunnel/id_ed25519 -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/lens/tunnel/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=15 -L 127.0.0.1:11434:127.0.0.1:11434 ${RUNPOD_SSH_TARGET}
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
