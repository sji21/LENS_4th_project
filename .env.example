# Django 로컬 개발 설정. SECRET_KEY는 README의 명령으로 각자 생성합니다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 게스트·회원 업로드 원본을 암호화할 때 사용합니다. 실제 값은 각자의 .env에만 둡니다.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LENS_FILE_ENCRYPTION_KEY=
LENS_PRIVATE_UPLOAD_ROOT=
DJANGO_SESSION_COOKIE_AGE=1209600

# 로컬 개발 기본값은 이 PC의 Ollama입니다. 운영 EC2는 SSH 터널의 로컬 주소를 사용합니다.
JEONSEON_LLM_BASE_URL=http://localhost:11434/v1
JEONSEON_LLM_MODEL=qwen3.8:27b
JEONSEON_LLM_TEMPERATURE=0.0
JEONSEON_LLM_TIMEOUT=180
JEONSEON_LLM_MAX_TOKENS=512
JEONSEON_LLM_NUM_CTX=8192
JEONSEON_LLM_REPEAT_PENALTY=1.1
JEONSEON_LLM_KEEP_ALIVE=30m
JEONSEON_LLM_NO_THINK=1

# 선택 사항: OpenAI 임베딩 비교를 실행할 때만 사용합니다. 현재 Qwen/Ollama 챗봇에는 필요하지 않습니다.
OPENAI_API_KEY=

# 국가법령정보 공동활용 API의 OC(인증 식별자)입니다.
# 판례 수집·재수집 명령은 이 변수만 사용합니다.
LAW_OPEN_API_OC=

# 선택 사항: PATH에서 Tesseract를 찾지 못하는 Windows 환경에서 지정합니다.
TESSERACT_CMD=

# 선택 사항: 기획서 PDF 생성기가 한국어 TTF 글꼴을 자동으로 찾지 못할 때 지정합니다.
KOREAN_FONT_PATH=

# 선택 사항: 법령·판례 관계형 DB와 Chroma 인덱스의 기본 로컬 경로를 변경합니다.
JEONSEON_DATABASE_PATH=
JEONSEON_CHROMA_PATH=

# 로컬 개발 기본값은 승인 원천 구축(setup_data.py)입니다.
# 현재 코드와 호환되는 팀 배포본 ZIP을 받은 경우에만 두 경로를 지정하고
# mysql_search activate로 active.json을 만듭니다. MySQL 접속은 필요 없습니다.
# 운영 EC2는 별도의 서버용 검색 배포본을 사용합니다(deploy/aws/MYSQL-SEARCH.md).
# 로컬 구축과 배포본을 동시에 설정하면 앱이 오류로 중단됩니다.
LENS_MYSQL_RELEASE=
LENS_MYSQL_MODEL_DIR=
# 선택형 배포 판례 프로필 경로. 팀 배포본에서는 비우고, 원천 구축에서도 비우면 기본 프로필을 사용합니다.
# PATCH-043 내부 실험 프로필은 제품에서 지원하지 않습니다.
LENS_CASE_RETRIEVAL_PROFILE=

# 담당자 전용: MySQL 지식 원문·청크 적재·내보내기. 팀원 검색 실행에는 필요 없습니다.
# Django 회원·대화 DB 설정과 별개입니다.
# python -m pip install -r requirements-mysql.txt
# 상세 명령과 구현 범위: docs/mysql-data.md
LENS_MYSQL_HOST=
LENS_MYSQL_PORT=3306
LENS_MYSQL_DATABASE=
LENS_MYSQL_USER=
LENS_MYSQL_PASSWORD=
# TLS를 사용하는 공용 DB에서는 검증할 CA 파일을 지정합니다.
LENS_MYSQL_SSL_CA=

# 선택 사항: LangSmith 실행 추적.
# 기본값은 비활성화이며, 사용할 때만 로컬 .env에서 true로 변경합니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lens-4th-project

# Experimental conversational routing; false restores the existing path.
CHAT_CONVERSATION_ENABLED=false

# ── AWS EC2 운영 배포 예시 ────────────────────────────────────────────
# 서울 리전(ap-northeast-2), Python 3.11, CloudFront → Nginx → Django 구성.
# 운영 배포 시 위의 동일한 항목을 아래 값으로 교체합니다.
# 로컬 기본값을 유지하도록 이 예시는 주석 처리했습니다.
# 비밀값 없는 전체 운영 예시: deploy/aws/lens.env.example
# 운영 안내: deploy/aws/README.md
#
# DJANGO_SETTINGS_MODULE=config.production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=REPLACE_WITH_CLOUDFRONT_DOMAIN
# DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
# LENS_FILE_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
# LENS_PRIVATE_UPLOAD_ROOT=/opt/lens/app/data/private
# LENS_MYSQL_RELEASE=/opt/lens/app/data/mysql-search/active.json
# LENS_MYSQL_MODEL_DIR=/opt/lens/app/data/models/kure-mysql
# LENS_CASE_RETRIEVAL_PROFILE=
# JEONSEON_LLM_BASE_URL=http://127.0.0.1:11434/v1
# JEONSEON_LLM_MODEL=qwen3.8:27b
# JEONSEON_LLM_TIMEOUT=90
# OMP_NUM_THREADS=2
# TOKENIZERS_PARALLELISM=false
#
# 실제 앱 설정은 EC2의 /etc/lens/lens.env에 저장합니다(lens:lens, 권한 0600).
# 127.0.0.1:11434는 EC2 내부 SSH 터널 입구입니다.
# 아래 SSH 항목은 앱 .env가 아니라 /etc/lens/runpod-tunnel.env에 설정합니다.
# 예시 파일: deploy/aws/runpod-tunnel.env.example (root:root, 권한 0600)
# RUNPOD_SSH_PORT=REPLACE_WITH_DIRECT_SSH_PORT
# RUNPOD_SSH_TARGET=root@REPLACE_WITH_DIRECT_SSH_HOST
#
# 현재 앱은 AWS API를 직접 호출하지 않으므로 AWS 액세스 키를 넣지 않습니다.
# EBS 정기 스냅샷은 별도 DLM 정책과 IAM 역할로 실행합니다.
# 실제 .env, 암호화 키, SSH 개인 키는 Git에 올리지 않습니다.
