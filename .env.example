# Django 로컬 개발 설정. SECRET_KEY는 README의 명령으로 각자 생성합니다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 회원이 올린 원본 문서를 암호화할 때 사용합니다. 실제 값은 각자의 .env에만 둡니다.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LENS_FILE_ENCRYPTION_KEY=
LENS_PRIVATE_UPLOAD_ROOT=
DJANGO_SESSION_COOKIE_AGE=1209600

# Ollama 연결 설정입니다. 기본값은 이 PC의 Ollama입니다.
JEONSEON_LLM_BASE_URL=http://localhost:11434/v1
# RunPod에서 11434/http를 공개했다면 위 값을 아래 형식으로 바꿉니다.
# JEONSEON_LLM_BASE_URL=https://YOUR_POD_ID-11434.proxy.runpod.net/v1
JEONSEON_LLM_MODEL=qwen3:8b-q4_K_M
JEONSEON_LLM_TEMPERATURE=0.0
JEONSEON_LLM_TIMEOUT=180
JEONSEON_LLM_MAX_TOKENS=512
JEONSEON_LLM_NUM_CTX=8192
JEONSEON_LLM_REPEAT_PENALTY=1.1
JEONSEON_LLM_KEEP_ALIVE=30m
JEONSEON_LLM_NO_THINK=1

# 선택 사항: OpenAI 임베딩 비교를 실행할 때만 사용합니다. 현재 Qwen/Ollama 챗봇에는 필요하지 않습니다.
OPENAI_API_KEY=

# 국가법령정보 공동활용 API의 OC(인증 식별자)입니다.
# 판례 수집·재수집 명령은 이 변수만 사용합니다.
LAW_OPEN_API_OC=

# 선택 사항: PATH에서 Tesseract를 찾지 못하는 Windows 환경에서 지정합니다.
TESSERACT_CMD=

# 선택 사항: 기획서 PDF 생성기가 한국어 TTF 글꼴을 자동으로 찾지 못할 때 지정합니다.
KOREAN_FONT_PATH=

# 선택 사항: 법령·판례 관계형 DB와 Chroma 인덱스의 기본 로컬 경로를 변경합니다.
JEONSEON_DATABASE_PATH=
JEONSEON_CHROMA_PATH=

# 검색 데이터 (README 6.0). 둘 중 하나만 사용합니다.
# A. 팀 배포본 ZIP (기본 권장): 아래 값을 그대로 두고 ZIP 설치 후
#    mysql_search activate로 active.json을 만듭니다. MySQL 접속은 필요 없습니다.
# B. 로컬 구축(setup_data.py): LENS_MYSQL_RELEASE와 LENS_MYSQL_MODEL_DIR을 비웁니다.
# 두 방식을 동시에 설정하면 앱이 오류로 중단됩니다.
LENS_MYSQL_RELEASE=data/mysql-search/active.json
LENS_MYSQL_MODEL_DIR=data/models/kure-mysql
# 판례 검색 프로필 경로. A에서는 반드시 비우고, B에서는 비우면 기본 프로필을 사용합니다.
LENS_CASE_RETRIEVAL_PROFILE=

# 담당자 전용: MySQL 지식 원문·청크 적재·내보내기. 팀원 검색 실행에는 필요 없습니다.
# Django 회원·대화 DB 설정과 별개입니다.
# python -m pip install -r requirements-mysql.txt
# 상세 명령과 구현 범위: docs/mysql-data.md
LENS_MYSQL_HOST=
LENS_MYSQL_PORT=3306
LENS_MYSQL_DATABASE=
LENS_MYSQL_USER=
LENS_MYSQL_PASSWORD=
# TLS를 사용하는 공용 DB에서는 검증할 CA 파일을 지정합니다.
LENS_MYSQL_SSL_CA=

# 선택 사항: LangSmith 실행 추적.
# 기본값은 비활성화이며, 사용할 때만 로컬 .env에서 true로 변경합니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jeonseon-patch031

# Experimental conversational routing; false restores the existing path.
CHAT_CONVERSATION_ENABLED=false
